# ============================================
# AI Customer Service Manager
# Environment Configuration
# ============================================

# Application
NODE_ENV=development
APP_NAME="AI Customer Service Manager"
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database - PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_cs_manager
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/ai_cs_manager?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# KirimDev WhatsApp API
KIRIMDEV_API_URL=https://api.kirimdev.com/v1
KIRIMDEV_API_KEY=kdv_live_xxxxxxxxxxxxxxxxxxxxxxxx
KIRIMDEV_PHONE_NUMBER_ID=your-phone-number-id
KIRIMDEV_WEBHOOK_SECRET=your-webhook-secret

# SumoPod AI API
SUMOPOD_API_URL=https://ai.sumopod.com/v1
SUMOPOD_API_KEY=sk-your-sumopod-api-key
SUMOPOD_DEFAULT_MODEL=deepseek-chat
SUMOPOD_EMBEDDING_MODEL=text-embedding-3-small

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# Notification - Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notification - Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AI CS Manager <noreply@example.com>"

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key!!

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Cors
CORS_ORIGINS=http://localhost:3000

# Backup
BACKUP_DIR=./backups
