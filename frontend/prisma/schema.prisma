generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum Role {
  OWNER
  SUPERVISOR
  CS
  VIEWER
}

enum ConversationStatus {
  ACTIVE
  AI_HANDLING
  NEED_HUMAN
  HUMAN_HANDLING
  CLOSED
}

enum HandlerType {
  AI
  HUMAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  TEMPLATE
  INTERACTIVE
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum SourceType {
  DOCUMENT
  EXCEL
  DATABASE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum DbType {
  POSTGRESQL
  MYSQL
  SQLSERVER
  MARIADB
  ORACLE
  SUPABASE
}

enum TemplateCategory {
  GREETING
  PROMO
  CLOSING
  THANK_YOU
  REMINDER
  INVOICE
  FOLLOW_UP
  BROADCAST
}


enum BroadcastStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum BroadcastLogStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum RegistrationStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

enum Channel {
  TELEGRAM
  EMAIL
  WHATSAPP
  BROWSER
}

model Company {
  id                   String                 @id @default(uuid())
  name                 String
  slug                 String                 @unique
  logo                 String?
  settings             Json?
  timezone             String                 @default("UTC")
  workingHours         Json?
  holidays             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  users                User[]
  aiProviders          AiProvider[]
  aiAgents             AiAgent[]
  contacts             Contact[]
  conversations        Conversation[]
  whatsappConfigs      WhatsAppConfig[]
  knowledgeBases       KnowledgeBase[]
  documents            Document[]
  databaseConnections  DatabaseConnection[]
  workflows            Workflow[]
  templates            Template[]
  broadcasts           Broadcast[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  companySettings      Setting[]
  registrations        Registration[]

  @@map("companies")
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  passwordHash         String
  name                 String
  role                 Role                   @default(VIEWER)
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  isActive             Boolean                @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime               @default(now())
  assignedConversations Conversation[]
  auditLogs            AuditLog[]

  @@index([companyId])
  @@map("users")
}

model AiProvider {
  id                   String                 @id @default(uuid())
  name                 String
  baseUrl              String
  apiKeyEncrypted      String
  model                String
  temperature          Float                  @default(0.7)
  topP                 Float                  @default(1.0)
  maxTokens            Int                    @default(1000)
  presencePenalty      Float                  @default(0)
  frequencyPenalty     Float                  @default(0)
  systemPrompt         String?
  isActive             Boolean                @default(true)
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  aiAgents             AiAgent[]

  @@index([companyId])
  @@map("ai_providers")
}

model AiAgent {
  id                   String                 @id @default(uuid())
  name                 String
  description          String?
  systemPrompt         String?
  role                 String?
  greeting             String?
  closing              String?
  fallbackMessage      String?
  workingHours         Json?
  language             String                 @default("en")
  tone                 String?
  maxConversation      Int                    @default(10)
  escalationRules      Json?
  isActive             Boolean                @default(true)
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  aiProviderId         String
  aiProvider           AiProvider             @relation(fields: [aiProviderId], references: [id])
  conversations        Conversation[]

  @@index([companyId])
  @@map("ai_agents")
}

model Contact {
  id                   String                 @id @default(uuid())
  name                 String?
  phone                String
  email                String?
  labels               String[]
  tags                 String[]
  status               String?
  notes                String?
  customFields         Json?
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  conversations        Conversation[]
  broadcastLogs        BroadcastLog[]
  registrations        Registration[]

  @@unique([phone, companyId])
  @@index([companyId])
  @@map("contacts")
}

model Conversation {
  id                   String                 @id @default(uuid())
  contactId            String
  contact              Contact                @relation(fields: [contactId], references: [id])
  agentId              String?
  agent                AiAgent?               @relation(fields: [agentId], references: [id])
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  status               ConversationStatus     @default(ACTIVE)
  handlerType          HandlerType            @default(AI)
  assignedUserId       String?
  assignedUser         User?                  @relation(fields: [assignedUserId], references: [id])
  metadata             Json?
  startedAt            DateTime               @default(now())
  endedAt              DateTime?
  createdAt            DateTime               @default(now())
  messages             Message[]

  @@index([companyId])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id                   String                 @id @default(uuid())
  conversationId       String
  conversation         Conversation           @relation(fields: [conversationId], references: [id])
  direction            MessageDirection
  type                 MessageType            @default(TEXT)
  content              String?
  metadata             Json?
  deliveryStatus       DeliveryStatus         @default(PENDING)
  isFromAi             Boolean                @default(false)
  aiConfidence         Float?
  externalId           String?
  sentAt               DateTime?
  createdAt            DateTime               @default(now())

  @@index([conversationId])
  @@map("messages")
}

model WhatsAppConfig {
  id                   String                 @id @default(uuid())
  name                 String
  apiBaseUrl           String
  apiKeyEncrypted      String
  webhookSecret        String
  phoneNumberId        String
  phoneNumber          String
  isActive             Boolean                @default(true)
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("whatsapp_configs")
}

model KnowledgeBase {
  id                   String                 @id @default(uuid())
  name                 String
  description          String?
  sourceType           SourceType             @default(DOCUMENT)
  config               Json?
  lastSyncedAt         DateTime?
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  createdAt            DateTime               @default(now())
  documents            Document[]

  @@index([companyId])
  @@map("knowledge_bases")
}

model Document {
  id                   String                 @id @default(uuid())
  knowledgeBaseId      String
  knowledgeBase        KnowledgeBase          @relation(fields: [knowledgeBaseId], references: [id])
  filename             String
  originalName         String
  mimeType             String?
  fileSize             Int?
  filePath             String
  version              Int                    @default(1)
  status               DocumentStatus         @default(PENDING)
  content              String?
  errorMessage         String?
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  uploadedAt           DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  chunks               DocumentChunk[]

  @@index([companyId])
  @@index([knowledgeBaseId])
  @@map("documents")
}

model DocumentChunk {
  id                   String                 @id @default(uuid())
  documentId           String
  document             Document               @relation(fields: [documentId], references: [id])
  content              String
  embedding            Unsupported("vector(1536)")?
  metadata             Json?
  chunkIndex           Int
  tokenCount           Int?

  @@index([documentId])
  @@map("document_chunks")
}

model DatabaseConnection {
  id                   String                 @id @default(uuid())
  name                 String
  dbType               DbType                 @default(POSTGRESQL)
  host                 String
  port                 Int
  database             String
  username             String
  passwordEncrypted    String
  schema               String?
  ssl                  Boolean                @default(false)
  isActive             Boolean                @default(true)
  lastTestedAt         DateTime?
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("database_connections")
}

model Workflow {
  id                   String                 @id @default(uuid())
  name                 String
  description          String?
  rules                Json
  priority             Int                    @default(0)
  isActive             Boolean                @default(true)
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([companyId])
  @@map("workflows")
}

model Template {
  id                   String                 @id @default(uuid())
  name                 String
  category             TemplateCategory       @default(GREETING)
  content              String
  variables            Json?
  isActive             Boolean                @default(true)
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  createdAt            DateTime               @default(now())
  broadcasts           Broadcast[]

  @@index([companyId])
  @@map("templates")
}


model Broadcast {
  id                   String                 @id @default(uuid())
  name                 String
  templateId           String
  template             Template               @relation(fields: [templateId], references: [id])
  targets              Json
  scheduledAt          DateTime?
  status               BroadcastStatus        @default(DRAFT)
  totalCount           Int                    @default(0)
  successCount         Int                    @default(0)
  failedCount          Int                    @default(0)
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  createdAt            DateTime               @default(now())
  broadcastLogs        BroadcastLog[]

  @@index([companyId])
  @@map("broadcasts")
}

model BroadcastLog {
  id                   String                 @id @default(uuid())
  broadcastId          String
  broadcast            Broadcast              @relation(fields: [broadcastId], references: [id])
  contactId            String
  contact              Contact                @relation(fields: [contactId], references: [id])
  status               BroadcastLogStatus     @default(PENDING)
  errorMessage         String?
  sentAt               DateTime?

  @@index([broadcastId])
  @@index([contactId])
  @@map("broadcast_logs")
}

model AuditLog {
  id                   String                 @id @default(uuid())
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id])
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  action               String
  resource             String
  resourceId           String?
  details              Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime               @default(now())

  @@index([companyId])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id                   String                 @id @default(uuid())
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  channel              Channel                @default(BROWSER)
  config               Json
  isActive             Boolean                @default(true)

  @@index([companyId])
  @@map("notifications")
}

model Setting {
  id                   String                 @id @default(uuid())
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  key                  String
  value                Json
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
  @@map("settings")
}

model Registration {
  id                   String                 @id @default(uuid())
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  contactId            String?
  contact              Contact?               @relation(fields: [contactId], references: [id])
  conversationId       String?
  name                 String
  phone                String
  program              String
  status               RegistrationStatus     @default(PENDING)
  paymentDeadline      DateTime
  paymentAmount        Float?
  paymentNote          String?
  paidAt               DateTime?
  validatedBy          String?
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("registrations")
}
